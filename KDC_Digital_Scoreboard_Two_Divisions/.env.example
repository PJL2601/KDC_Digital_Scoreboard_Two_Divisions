# Copy to .env (or use .env.boys / .env.girls - see README). Set a long random secret.
#
# DIVISION - which scoreboard this deployment is:
#   KDC_DIVISION=boys    -> database kdc_boys.db   (or BOYS_DATABASE_URL)
#   KDC_DIVISION=girls   -> database kdc_girls.db  (or GIRLS_DATABASE_URL)
#   (unset)              -> ORIGINAL single-scoreboard mode, uses DATABASE_URL
KDC_DIVISION=boys
FLASK_SECRET_KEY=KDC-ChangeThis-To-A-Long-Random-Secret-2026
ADMIN_SETUP_CODE=KDC-Setup-2026-ChangeMe
PUBLIC_BASE_URL=http://127.0.0.1:5001
# BOYS_DATABASE_URL=postgresql://user:password@host:5432/kdc_boys
# GIRLS_DATABASE_URL=postgresql://user:password@host:5432/kdc_girls
# Original single mode only:
# DATABASE_URL=sqlite:///kdc_scoreboard.db
