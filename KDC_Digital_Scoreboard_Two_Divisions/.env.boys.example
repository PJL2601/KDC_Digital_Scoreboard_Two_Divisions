# Boys deployment settings. Copy to .env.boys (local) or set these as
# environment variables on your hosting service.
KDC_DIVISION=boys
FLASK_SECRET_KEY=replace-with-a-long-random-secret-UNIQUE-to-boys
ADMIN_SETUP_CODE=replace-with-a-private-setup-code-UNIQUE-to-boys
PUBLIC_BASE_URL=https://boys.example.com
COOKIE_SECURE=1
# Optional PostgreSQL (otherwise SQLite instance/kdc_boys.db is used):
# BOYS_DATABASE_URL=postgresql://user:password@host:5432/kdc_boys
