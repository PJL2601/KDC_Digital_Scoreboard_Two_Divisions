# Girls deployment settings. Copy to .env.girls (local) or set these as
# environment variables on your hosting service.
KDC_DIVISION=girls
FLASK_SECRET_KEY=replace-with-a-long-random-secret-UNIQUE-to-girls
ADMIN_SETUP_CODE=replace-with-a-private-setup-code-UNIQUE-to-girls
PUBLIC_BASE_URL=https://girls.example.com
COOKIE_SECURE=1
# Optional PostgreSQL (otherwise SQLite instance/kdc_girls.db is used):
# GIRLS_DATABASE_URL=postgresql://user:password@host:5432/kdc_girls
